# Configuracao do backup. Copie para backup.env e ajuste.
#   cp backup.env.example backup.env && chmod 600 backup.env

# Onde ficam as copias locais (camadas diario/, semanal/, mensal/).
BACKUP_DIR=/home/api/api_pharmaprice/backups

# Usuario do MySQL usado no dump. root e o padrao do container.
BACKUP_DB_USER=root

# Retencao avo-pai-filho. Com estes valores voce consegue voltar a qualquer dia
# da ultima semana, a qualquer semana do ultimo mes e a qualquer mes do ultimo
# semestre - ao custo de ~17 arquivos.
RETENCAO_DIARIA=7
RETENCAO_SEMANAL=4
RETENCAO_MENSAL=6

# Barreira contra dump vazio ou truncado ser aceito como backup valido.
# Ajuste conforme a base cresce (hoje o dump comprimido tem ~23 MB).
TAMANHO_MINIMO_BYTES=10000000

# Destino remoto (rclone). Configure antes com: rclone config
# Exemplos: b2:pharmaprice-backups | s3:pharmaprice-backups | drive:backups/pharmaprice
RCLONE_REMOTE=b2:pharmaprice-backups

# Arquivo com a senha de criptografia do backup.
#   openssl rand -base64 48 > /root/.pharmaprice_backup_pass
#   chmod 600 /root/.pharmaprice_backup_pass
#
# GUARDE ESSA SENHA FORA DESTE SERVIDOR. Sem ela o backup nao volta - e se o
# unico lugar onde ela existe e a maquina que voce esta protegendo, ela nao
# protege nada.
BACKUP_PASSPHRASE_FILE=/root/.pharmaprice_backup_pass

# Deixe 0. Em 1, permite subir a base inteira para a nuvem sem criptografia.
BACKUP_PERMITIR_TEXTO_CLARO=0

# Monitor de silencio (healthchecks.io, Uptime Kuma etc). O script pinga a URL
# ao concluir e a URL/fail ao falhar; o servico avisa se o ping nao chegar.
# Sem isto, um backup que parou de rodar so aparece no dia em que voce precisar
# dele.
HEALTHCHECK_URL=
HEALTHCHECK_RESTORE_URL=
