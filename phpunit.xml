<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Base separada, e nao sqlite em memoria: as migrations usam SQL
            especifico de MySQL (CREATE OR REPLACE VIEW, INSERT ... ON
            DUPLICATE KEY UPDATE, IN de tuplas), entao um sqlite testaria outra
            coisa. E nao a `webscrap`: RefreshDatabase apagaria a restauracao de
            producao usada para medir desempenho.

            Criar uma vez:
              CREATE DATABASE webscrap_test CHARACTER SET utf8mb4
                COLLATE utf8mb4_unicode_ci;
              GRANT ALL PRIVILEGES ON webscrap_test.* TO 'suporte'@'%';
        -->
        <env name="DB_DATABASE" value="webscrap_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
